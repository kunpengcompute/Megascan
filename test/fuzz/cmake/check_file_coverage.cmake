if(NOT DEFINED TRACEFILE OR NOT EXISTS "${TRACEFILE}")
    message(FATAL_ERROR "Coverage tracefile does not exist: ${TRACEFILE}")
endif()
if(NOT DEFINED SOURCE_ROOT OR NOT DEFINED MINIMUM)
    message(FATAL_ERROR "SOURCE_ROOT and MINIMUM are required")
endif()

file(STRINGS "${TRACEFILE}" COVERAGE_LINES)
set(CURRENT_SOURCE "")
set(LINES_FOUND 0)
set(LINES_HIT 0)
set(CHECKED_FILES 0)
set(FAILED_FILES "")

foreach(LINE IN LISTS COVERAGE_LINES)
    if(LINE MATCHES "^SF:(.*)$")
        set(CURRENT_SOURCE "${CMAKE_MATCH_1}")
        set(LINES_FOUND 0)
        set(LINES_HIT 0)
    elseif(LINE MATCHES "^LF:([0-9]+)$")
        set(LINES_FOUND "${CMAKE_MATCH_1}")
    elseif(LINE MATCHES "^LH:([0-9]+)$")
        set(LINES_HIT "${CMAKE_MATCH_1}")
    elseif(LINE STREQUAL "end_of_record")
        string(FIND "${CURRENT_SOURCE}" "${SOURCE_ROOT}/" SOURCE_PREFIX)
        if(SOURCE_PREFIX EQUAL 0 AND LINES_FOUND GREATER 0)
            math(EXPR COVERAGE_X100
                 "${LINES_HIT} * 10000 / ${LINES_FOUND}")
            math(EXPR REQUIRED_X100 "${MINIMUM} * 100")
            math(EXPR WHOLE "${COVERAGE_X100} / 100")
            math(EXPR FRACTION "${COVERAGE_X100} % 100")
            if(FRACTION LESS 10)
                set(PERCENT "${WHOLE}.0${FRACTION}")
            else()
                set(PERCENT "${WHOLE}.${FRACTION}")
            endif()
            math(EXPR CHECKED_FILES "${CHECKED_FILES} + 1")
            if(COVERAGE_X100 LESS REQUIRED_X100)
                list(APPEND FAILED_FILES
                     "${CURRENT_SOURCE}|${PERCENT}|${LINES_HIT}|${LINES_FOUND}")
            endif()
        endif()
    endif()
endforeach()

if(CHECKED_FILES EQUAL 0)
    message(FATAL_ERROR "No files under ${SOURCE_ROOT} were found in ${TRACEFILE}")
endif()

if(FAILED_FILES)
    message(STATUS "Files below ${MINIMUM}% line coverage:")
    foreach(ENTRY IN LISTS FAILED_FILES)
        string(REPLACE "|" ";" FIELDS "${ENTRY}")
        list(GET FIELDS 0 FILE_NAME)
        list(GET FIELDS 1 FILE_PERCENT)
        list(GET FIELDS 2 FILE_HIT)
        list(GET FIELDS 3 FILE_FOUND)
        message(STATUS
                "  ${FILE_PERCENT}% (${FILE_HIT}/${FILE_FOUND}) ${FILE_NAME}")
    endforeach()
    list(LENGTH FAILED_FILES FAILED_COUNT)
    message(FATAL_ERROR
            "${FAILED_COUNT}/${CHECKED_FILES} ms/src files are below ${MINIMUM}%")
endif()

message(STATUS
        "Coverage gate passed: all ${CHECKED_FILES} ms/src files >= ${MINIMUM}%")
