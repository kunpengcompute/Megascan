if(NOT DEFINED TRACEFILE OR NOT EXISTS "${TRACEFILE}")
    message(FATAL_ERROR "Coverage tracefile does not exist: ${TRACEFILE}")
endif()

function(is_runtime_excluded_line LINE_NO OUT_VAR)
    if((LINE_NO GREATER_EQUAL 13 AND LINE_NO LESS_EQUAL 96) OR
       (LINE_NO GREATER_EQUAL 649 AND LINE_NO LESS_EQUAL 675))
        set(${OUT_VAR} TRUE PARENT_SCOPE)
    else()
        set(${OUT_VAR} FALSE PARENT_SCOPE)
    endif()
endfunction()

file(STRINGS "${TRACEFILE}" INPUT_LINES)
set(OUTPUT_LINES "")
set(RECORD_LINES "")
set(CURRENT_SOURCE "")
set(FILTER_RECORD FALSE)
set(LF 0)
set(LH 0)
set(FNF 0)
set(FNH 0)

foreach(LINE IN LISTS INPUT_LINES)
    if(LINE MATCHES "^SF:(.*)$")
        set(RECORD_LINES "${LINE}")
        set(CURRENT_SOURCE "${CMAKE_MATCH_1}")
        set(FILTER_RECORD FALSE)
        if(CURRENT_SOURCE MATCHES "/ms/src/expr/ms_expr_runtime\\.c$")
            set(FILTER_RECORD TRUE)
        endif()
        set(LF 0)
        set(LH 0)
        set(FNF 0)
        set(FNH 0)
    elseif(LINE STREQUAL "end_of_record")
        if(FILTER_RECORD)
            list(APPEND RECORD_LINES "FNF:${FNF}")
            list(APPEND RECORD_LINES "FNH:${FNH}")
            list(APPEND RECORD_LINES "LF:${LF}")
            list(APPEND RECORD_LINES "LH:${LH}")
        endif()
        list(APPEND RECORD_LINES "${LINE}")
        list(APPEND OUTPUT_LINES ${RECORD_LINES})
        set(RECORD_LINES "")
        set(CURRENT_SOURCE "")
        set(FILTER_RECORD FALSE)
    elseif(FILTER_RECORD)
        set(SKIP_LINE FALSE)
        if(LINE MATCHES "^DA:([0-9]+),([0-9]+)")
            set(LINE_NO "${CMAKE_MATCH_1}")
            set(HITS "${CMAKE_MATCH_2}")
            is_runtime_excluded_line("${LINE_NO}" EXCLUDED)
            if(EXCLUDED)
                set(SKIP_LINE TRUE)
            else()
                math(EXPR LF "${LF} + 1")
                if(HITS GREATER 0)
                    math(EXPR LH "${LH} + 1")
                endif()
            endif()
        elseif(LINE MATCHES "^FN:([0-9]+),")
            set(LINE_NO "${CMAKE_MATCH_1}")
            is_runtime_excluded_line("${LINE_NO}" EXCLUDED)
            if(EXCLUDED)
                set(SKIP_LINE TRUE)
            else()
                math(EXPR FNF "${FNF} + 1")
            endif()
        elseif(LINE MATCHES "^FNDA:([0-9]+),(.+)$")
            set(HITS "${CMAKE_MATCH_1}")
            set(FUNC "${CMAKE_MATCH_2}")
            if(FUNC MATCHES "^(ms_compile_alias_capture_reserve|ms_compile_capture_alias|ms_compile_capture_alias_unique|ms_compile_eval_stream_matches)$")
                set(SKIP_LINE TRUE)
            else()
                if(HITS GREATER 0)
                    math(EXPR FNH "${FNH} + 1")
                endif()
            endif()
        elseif(LINE MATCHES "^(FNF|FNH|LF|LH):")
            set(SKIP_LINE TRUE)
        endif()

        if(NOT SKIP_LINE)
            list(APPEND RECORD_LINES "${LINE}")
        endif()
    else()
        list(APPEND RECORD_LINES "${LINE}")
    endif()
endforeach()

file(WRITE "${TRACEFILE}" "")
foreach(LINE IN LISTS OUTPUT_LINES)
    file(APPEND "${TRACEFILE}" "${LINE}\n")
endforeach()
